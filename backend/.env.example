APP_PORT=8080
DATABASE_URL=postgres://Finova:Finova@localhost:5432/Finova?sslmode=disable

# Market-data crawler (TSETMC). All optional; sensible defaults are built in.
# TSETMC_BASE_URL=https://cdn.tsetmc.com/api
# TSETMC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...
# Reliability (defaults shown): per-request timeout, total attempts incl. the
# first (retries on network errors, 5xx, 429 with exponential backoff), and
# requests/second (0 = unlimited).
# TSETMC_TIMEOUT=10s
# TSETMC_MAX_ATTEMPTS=3
# TSETMC_RATE_LIMIT=2
# Enable the background option-chain collector (e.g. 60s, 2m). Empty = disabled.
# COLLECT_INTERVAL=
