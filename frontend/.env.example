# Mock data is ON by default: the market pages work with no backend.
# Set to false to call the real API (not tested against a server yet).
VITE_USE_MOCK=true

# Backend origin (the Go server listens on APP_PORT, default 8080).
VITE_API_BASE_URL=http://localhost:8080

# In mock mode, add these to the page URL to see the other states:
#   ?mockError=1   all requests fail (error state + retry button)
#   ?mockEmpty=1   all lists come back empty (empty state)
