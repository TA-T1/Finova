# false: the market watch, chain and symbol pages call the real API (see docs/frontend-api-notes.md
# for how to start the backend with the demo data). true: everything runs on mock data, no backend.
# Copy this file to .env.local. Without any env file the app still runs on mock data.
VITE_USE_MOCK=false

# The backend has no strategy or backtest endpoints yet, so these two pages stay on mock data even
# when VITE_USE_MOCK=false. Set to true once the endpoints exist.
# VITE_STRATEGY_API=true
# VITE_BACKTEST_API=true

# Backend origin (the Go server listens on APP_PORT, default 8080).
VITE_API_BASE_URL=http://localhost:8080

# In mock mode, add these to the page URL to see the other states:
#   ?mockError=1   all requests fail (error state + retry button)
#   ?mockEmpty=1   all lists come back empty (empty state)
